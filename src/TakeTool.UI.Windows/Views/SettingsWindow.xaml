<Window x:Class="TakeTool.UI.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TakeTool.UI.Windows.Converters"
        Title="TakeTool Settings"
        Width="560"
        Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8F6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </Window.Resources>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="TakeTool"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1B3A4B"
                       DockPanel.Dock="Left" />
            <TextBlock Text="Settings"
                       FontSize="16"
                       VerticalAlignment="Bottom"
                       Margin="12,0,0,4"
                       Foreground="#3D8B7A" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="#2E7D4F" />
            <Button Content="Save"
                    Width="100"
                    Height="32"
                    Click="SaveButton_OnClick"
                    Background="#1B3A4B"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="General"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1B3A4B"
                           Margin="0,0,0,8" />

                <TextBlock Text="Overlay opacity" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right"
                               Width="40"
                               Text="{Binding OverlayOpacity, StringFormat={}{0:0.00}}" />
                    <Slider Minimum="0.3"
                            Maximum="1"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Value="{Binding OverlayOpacity}" />
                </DockPanel>

                <CheckBox Content="Expand arc menu on hover (uncheck to use click)"
                          IsChecked="{Binding ExpandOnHover}"
                          Margin="0,0,0,8" />
                <CheckBox Content="Start with operating system (wiring in a later phase)"
                          IsChecked="{Binding StartWithOperatingSystem}"
                          Margin="0,0,0,20" />

                <TextBlock Text="Utilities"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#1B3A4B"
                           Margin="0,0,0,4" />
                <TextBlock Text="Only utilities compatible with this OS are listed. Toggle to enable them in the overlay."
                           TextWrapping="Wrap"
                           Foreground="#555"
                           Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding Utilities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D0D5D2"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,12"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#555" />
                                            <TextBlock Foreground="#888" FontSize="11">
                                                <Run Text="Platforms: " />
                                                <Run Text="{Binding Platforms, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="28,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#777"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <Grid>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28"
                                                                 Visibility="{Binding IsPassword, Converter={StaticResource InverseBoolToVis}}" />
                                                        <PasswordBox Height="28"
                                                                     Visibility="{Binding IsPassword, Converter={StaticResource BoolToVis}}"
                                                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                                                     Tag="{Binding}" />
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
