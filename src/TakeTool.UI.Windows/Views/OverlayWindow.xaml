<Window x:Class="TakeTool.UI.Windows.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TakeTool.UI.Windows.ViewModels"
        Title="TakeTool"
        Width="280"
        Height="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Opacity="{Binding Opacity}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{StaticResource SlotBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SlotBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          AllowDrop="True"
          Background="Transparent"
          MouseEnter="RootGrid_OnMouseEnter"
          MouseLeave="RootGrid_OnMouseLeave"
          DragEnter="RootGrid_OnDragEnter"
          DragOver="RootGrid_OnDragOver"
          DragLeave="RootGrid_OnDragLeave"
          Drop="RootGrid_OnDrop">

        <!-- Feedback toast -->
        <Border Width="220"
                Margin="0,12,0,0"
                Padding="10,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="8"
                Visibility="{Binding IsFeedbackVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource FeedbackOkBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FeedbackIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource FeedbackErrorBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{Binding FeedbackTitle}"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontSize="12" />
                <TextBlock Text="{Binding FeedbackMessage}"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="11"
                           Opacity="0.95" />
            </StackPanel>
        </Border>

        <!-- Arc utility slots -->
        <ItemsControl ItemsSource="{Binding Slots}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                      IsHitTestVisible="{Binding IsExpanded}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Width="280" Height="280" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="186" />
                    <Setter Property="Canvas.Top" Value="186" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UtilitySlotViewModel}">
                    <Button Style="{StaticResource SlotButtonStyle}"
                            ToolTip="{Binding Name}"
                            Tag="{Binding}"
                            Click="UtilitySlot_OnClick"
                            AllowDrop="True"
                            PreviewDragOver="UtilitySlot_OnPreviewDragOver"
                            Drop="UtilitySlot_OnDrop"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                        </Button.RenderTransform>
                        <TextBlock Text="{Binding Name}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Width="40"
                                   Foreground="#1B3A4B" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Hub button (bottom-right of overlay canvas) -->
        <Button x:Name="HubButton"
                Width="56"
                Height="56"
                Margin="0,0,24,24"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Cursor="Hand"
                AllowDrop="True"
                PreviewMouseLeftButtonDown="HubButton_OnPreviewMouseLeftButtonDown"
                PreviewMouseMove="HubButton_OnPreviewMouseMove"
                PreviewMouseLeftButtonUp="HubButton_OnPreviewMouseLeftButtonUp"
                Click="HubButton_OnClick"
                ToolTip="TakeTool">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{StaticResource HubBrush}" />
                        <Ellipse Margin="6"
                                 Fill="{StaticResource HubAccentBrush}"
                                 Opacity="0.85" />
                        <TextBlock Text="TT"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Tray icon -->
        <tb:TaskbarIcon xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                        x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Resources/tray.ico"
                        ToolTipText="TakeTool"
                        MenuActivation="RightClick"
                        TrayMouseDoubleClick="TrayIcon_OnTrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Overlay" Click="TrayShow_OnClick" />
                    <MenuItem Header="Hide Overlay" Click="TrayHide_OnClick" />
                    <Separator />
                    <MenuItem Header="Settings" Click="TraySettings_OnClick" />
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_OnClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
